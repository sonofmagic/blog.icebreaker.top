{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "icebreaker-blog",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "routes": [
    { "pattern": "blog.icebreaker.top/*", "zone_name": "icebreaker.top" }
  ],
  "assets": {
    "directory": "./blog/.output/public",
    "not_found_handling": "404-page"
  }
}
