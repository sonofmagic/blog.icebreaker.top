{
  "name": "monorepo-template",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "vitest run --coverage.enabled",
    "test:dev": "vitest",
    "lint": "turbo run lint",
    "release": "changeset",
    "publish-packages": "turbo run build lint test && changeset version && changeset publish",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "commit": "commit",
    "script:init": "repoctl workspace init",
    "script:clean": "repoctl workspace clean",
    "script:mirror": "repoctl env mirror",
    "commitlint": "commitlint --edit",
    "typecheck": "pnpm --filter @icebreakers/blog typecheck"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/prompt-cli": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@icebreakers/commitlint-config": "^4.1.1",
    "@icebreakers/eslint-config": "^8.0.6",
    "@icebreakers/monorepo": "^5.5.10",
    "@icebreakers/stylelint-config": "^5.1.3",
    "@types/fs-extra": "^11.0.4",
    "@types/klaw": "^3.0.8",
    "@types/lodash": "^4.17.25",
    "@types/lodash-es": "^4.17.12",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^24.19.0",
    "@types/semver": "^7.8.0",
    "@types/set-value": "^4.0.3",
    "@vitest/coverage-v8": "~5.0.3",
    "ci-info": "^4.4.0",
    "cross-env": "^10.1.0",
    "defu": "^6.1.7",
    "es-toolkit": "^1.52.0",
    "eslint": "^10.11.0",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "get-value": "^4.1.0",
    "husky": "^9.1.7",
    "klaw": "^4.1.0",
    "lint-staged": "^17.6.0",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "micromatch": "^4.0.8",
    "only-allow": "^1.2.2",
    "pathe": "^2.0.3",
    "pkg-types": "^2.3.3",
    "rimraf": "^6.1.3",
    "set-value": "^4.1.0",
    "stylelint": "^17.15.0",
    "tsdown": "^0.23.0",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.5",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "vitest": "~5.0.3",
    "wrangler": "^4.145.0",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
